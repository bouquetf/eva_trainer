{
  "request": {
    "method": "POST",
    "urlPath": "/api/oauth2/token"
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "access_token": "mock-access-token",
      "token_type": "Bearer",
      "expires_in": 604800,
      "refresh_token": "mock-refresh-token",
      "scope": "identify"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
