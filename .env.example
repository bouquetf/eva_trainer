# ===============================================
# Eva Trainer - Configuration variables d'environnement
# ===============================================
# Usage : Copier ce fichier en .env et ajuster les valeurs
# cp .env.example .env
# ===============================================

# Server
PORT=8080
GIN_MODE=debug
SERVER_FRONTEND_URL=http://localhost:5173

# Database (individual)
DB_HOST=localhost
DB_PORT=5432
DB_USER=eva_user
DB_PASSWORD=eva_pass
DB_NAME=eva_trainer
DB_SSLMODE=disable
DB_TIMEOUT=10

# Database (URL - prioritaire sur les vars individuelles)
DATABASE_URL=postgres://eva_user:eva_pass@localhost:5432/eva_trainer?sslmode=disable

# CORS
CORS_ORIGINS=*

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:8080/api/v1/auth/discord/callback

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d
