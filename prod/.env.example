# =============================================================================
# Eva Trainer - Variables d'environnement (Production)
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs :
#   cp prod/.env.example prod/.env
# =============================================================================

# --- Requis : PostgreSQL ------------------------------------------------
# Mot de passe fort pour l'utilisateur PostgreSQL
DB_PASSWORD=<changer-mot-de-passe-fort>

# --- Requis : JWT --------------------------------------------------------
# Clé secrète pour signer les tokens JWT (min. 32 caractères)
JWT_SECRET=<changer-votre-cle-jwt-32-caracteres-minimum>

# --- Requis : Discord OAuth ---------------------------------------------
# Identifiants de l'application Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=<votre-discord-client-id>
DISCORD_CLIENT_SECRET=<votre-discord-client-secret>

# --- Optionnel : Discord -------------------------------------------------
# URL de callback Discord (doit correspondre à l'URI enregistrée dans le portail développeur)
# Valeur par défaut : http://localhost:8080/api/v1/auth/discord/callback
# DISCORD_REDIRECT_URL=http://localhost:8080/api/v1/auth/discord/callback

# --- Optionnel : Frontend (build-time) ----------------------------------
# URL de l'API utilisée par le frontend (compilée dans le JS au build)
# Doit correspondre à l'URL publique de l'application.
# VITE_API_URL=http://localhost:8080

# --- Optionnel : Serveur ------------------------------------------------
# Port hôte pour exposer l'application
# HOST_PORT=8080

# Mode Gin (release / debug)
# GIN_MODE=release

# URL publique du frontend (pour les redirections après auth)
# SERVER_FRONTEND_URL=http://localhost:8080

# --- Optionnel : CORS ----------------------------------------------------
# Origines CORS autorisées (séparées par des virgules)
# CORS_ORIGINS=http://localhost:8080

# --- Optionnel : Base de données ----------------------------------------
# Ces variables ne sont utilisées que si DATABASE_URL n'est pas définie.
# La production utilise DATABASE_URL construite depuis les variables du docker-compose.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=eva_user
# DB_NAME=eva_trainer
# DB_SSLMODE=disable

# --- Optionnel : JWT -----------------------------------------------------
# Durée de validité du token d'accès
# JWT_EXPIRY=24h
# Durée de validité du refresh token
# REFRESH_TOKEN_EXPIRY=168h

# --- Optionnel : Logging -------------------------------------------------
# Niveau de log (debug / info / warn / error)
# LOG_LEVEL=info
# Format de log (auto / json / text)
# LOG_FORMAT=auto
